APP_NAME=Statamic
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Laravel Cloud injects DB_HOST/DB_USERNAME/DB_PASSWORD/DB_DATABASE when a MySQL
# database is attached, but not DB_CONNECTION — set that in the dashboard too.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Production uses Laravel Cloud managed queues: set QUEUE_CONNECTION=cloud in the
# dashboard. That connection is injected at runtime and does not exist locally.
QUEUE_CONNECTION=sync

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# mail.kotyk.com is served by this app as a redirect so the hostname gets a real
# certificate. Point its DNS at the Cloud environment and add it as a domain there.
MAIL_SUBDOMAIN_HOST=mail.kotyk.com
MAIL_SUBDOMAIN_TARGET=https://mail.google.com/a/kotyk.com

VITE_APP_NAME="${APP_NAME}"

STATAMIC_LICENSE_KEY=
STATAMIC_PRO_ENABLED=false
STATAMIC_STACHE_WATCHER=true

# Statamic's built-in handler runs every minute and is minute-scoped, so it
# cannot be slowed down. Replaced by the hourly entries:handle-hourly-schedule.
STATAMIC_HANDLE_SCHEDULED_ENTRIES=false
# Local stays dynamic so dev renders don't write orphaned derivatives into the
# production glide bucket (nothing ever cleans it). Set to 'glide' on Cloud.
STATAMIC_GLIDE_CACHE=false
STATAMIC_STATIC_CACHING_STRATEGY=half
STATAMIC_REVISIONS_ENABLED=false
STATAMIC_GRAPHQL_ENABLED=false
STATAMIC_API_ENABLED=false
STATAMIC_GIT_ENABLED=false

FORGE_DEPLOY_URL=
CLOUD_DEPLOY_URL=
# Used by bin/deploy.sh to poll the Cloud API until a deployment finishes,
# so the cache is warmed against the new release rather than the outgoing one.
LARAVEL_CLOUD_API_TOKEN=
# The deployed site, used by bin/deploy.sh to warm the cache after deploying.
# Not APP_URL - that is the local development host.
LARAVEL_CLOUD_SITE_URL=https://kotyk.com

# Content and users are flat files authored locally and deployed via git, so the
# Control Panel is disabled in production. Set CP_ENABLED=false on Laravel Cloud.
CP_ENABLED=true

# Injected by Laravel Cloud as a JSON blob; set locally to use the same bucket.
LARAVEL_CLOUD_DISK_CONFIG=
