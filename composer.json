{
    "name": "sheldonkotyk/kotyk.com",
    "type": "project",
    "description": "Kotyk.com - the online abode of Sheldon Kotyk",
    "keywords": [
        "laravel",
        "livewire",
        "blog"
    ],
    "require": {
        "php": "^8.2",
        "abigah/bot-cop-traffic-client": "dev-main",
        "aws/aws-sdk-php": "^3.394",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.9",
        "league/flysystem-aws-s3-v3": "^3.35",
        "livewire/livewire": "^4.4",
        "resend/resend-laravel": "^1.0",
        "spatie/laravel-ray": "^1.40",
        "symfony/yaml": "^7.4 || ^8.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.0",
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^2.1",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^12.0",
        "spatie/laravel-ignition": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\""
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "name": "bot-cop-traffic-client",
            "type": "vcs",
            "url": "https://github.com/abigah/bot-cop-traffic-client"
        }
    ]
}
